{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schema_version": {"type": "string"},
    "tool_version": {"type": "string"},
    "exit_code": {"type": "integer"},
    "error": {"type": ["string", "null"]},
    "engine_used": {"type": "string"},
    "zxcvbn_score": {"type": ["integer", "null"]},
    "score": {
      "type": ["object", "null"],
      "properties": {
        "value": {"type": "integer"},
        "rating": {"type": "string"},
        "base": {"type": "integer"},
        "capped_by": {"type": ["string", "null"]}
      },
      "required": ["value", "rating"]
    },
    "pattern": {
      "type": ["object", "null"],
      "properties": {
        "detected": {"type": "boolean"},
        "rules_fired": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["detected", "rules_fired"]
    }
  },
  "required": ["schema_version", "tool_version", "exit_code", "engine_used"]
}